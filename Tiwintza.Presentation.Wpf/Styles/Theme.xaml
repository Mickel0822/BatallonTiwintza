<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- COLORES (Color) -->
    <Color x:Key="Burgundy">#7B1E3D</Color>
    <Color x:Key="Navy">#0C2B5A</Color>
    <Color x:Key="Gold">#F3D50B</Color>
    <Color x:Key="Laurel">#5A6E3A</Color>
    <Color x:Key="Surface">#F8FAFC</Color>
    <Color x:Key="OnSurface">#1F2937</Color>

    <!-- BRUSHES (usar en Foreground/Background/BorderBrush) -->
    <SolidColorBrush x:Key="BurgundyBrush" Color="{StaticResource Burgundy}"/>
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource Navy}"/>
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
    <SolidColorBrush x:Key="LaurelBrush" Color="{StaticResource Laurel}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}"/>

    <!-- FONDO APP -->
    <LinearGradientBrush x:Key="AppGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Burgundy}" Offset="0"/>
        <GradientStop Color="{StaticResource Navy}" Offset="1"/>
    </LinearGradientBrush>

    <!-- CARD -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="28"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TEXTBOX -->
    <Style TargetType="{x:Type TextBox}">
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PASSWORDBOX -->
    <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="6"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BOTÓN PRIMARIO (burgundy->navy) -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Burgundy}" Offset="0"/>
                    <GradientStop Color="{StaticResource Navy}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border CornerRadius="10" Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.95"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- BOTÓN SECUNDARIO -->
    <Style x:Key="GhostButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#FFF6D1"/>
        <Setter Property="Foreground" Value="{StaticResource BurgundyBrush}"/>
    </Style>

</ResourceDictionary>
