<!-- Styles/Theme.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Tiwintza.Presentation.Wpf.Converters">

    
    
    
    
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Styles/Colors.xaml"/>
        <ResourceDictionary Source="/Styles/Typography.xaml"/>
        <ResourceDictionary Source="/Styles/Controls.xaml"/>
        <ResourceDictionary Source="/Styles/Inputs.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Converters -->
    <conv:EstadoToBrushConverter x:Key="EstadoToBrush"/>
    <conv:DateOnlyToStringConverter x:Key="DateOnlyToString" Format="dd/MM/yyyy"/>
    <conv:ZeroToNullLongConverter x:Key="ZeroToNullLong"/>
    




    <!-- Defaults tipográficos -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource Body}"/>

    <!-- Defaults de controles -->
    <!-- Aplica el estilo de entrada a TODOS los ComboBox -->
    <Style TargetType="ComboBox" BasedOn="{StaticResource InputComboBox}"/>
    <Style TargetType="DataGrid" BasedOn="{StaticResource GridTable2025}"/>

</ResourceDictionary>
