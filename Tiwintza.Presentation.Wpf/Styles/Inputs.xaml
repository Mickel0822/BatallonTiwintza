<!-- Styles/Inputs.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- Toggle “fantasma” para abrir/cerrar el popup sin pintar nada -->
    <Style x:Key="DropDownToggle.Invisible" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- Sin visuales -->
                    <Border Background="{TemplateBinding Background}" BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    

    <!-- ========= TextBox ========= -->
    <Style x:Key="InputTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"/>
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,6,10,6"/>
                        <!-- placeholder con Tag -->
                        <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Tag}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="12,6,12,6"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ======== PasswordBox ======== -->
    <Style x:Key="InputPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,6,10,6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========= ComboBox (no editable) ========= -->
    <Style x:Key="InputComboBox" TargetType="ComboBox"
       xmlns:sys="clr-namespace:System;assembly=mscorlib">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="10,6,34,6"/>
        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <!-- Búsqueda por texto sobre la propiedad Nombre -->
        <Setter Property="IsTextSearchEnabled" Value="True"/>
        <Setter Property="TextSearch.TextPath" Value="Nombre"/>

        <!-- TEMPLATE -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                            CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"/>

                        <!-- Placeholder (usa Tag del ComboBox) -->
                        <TextBlock x:Name="Placeholder"
                               Text="{TemplateBinding Tag}"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="12,6,34,6"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>

                        <!-- Texto seleccionado (SelectedItem.Nombre) -->
                        <TextBlock x:Name="SelectedText"
                               Margin="{TemplateBinding Padding}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding SelectedItem.Nombre,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                               IsHitTestVisible="False"/>

                        <!-- Flecha -->
                        <Path x:Name="Arrow"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="2"
                          Stretch="Uniform"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          IsHitTestVisible="False"/>

                        <!-- Toggle invisible que gobierna IsDropDownOpen -->
                        <ToggleButton x:Name="DropDownToggle"
                                  Style="{StaticResource DropDownToggle.Invisible}"
                                  Panel.ZIndex="10"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- Popup -->
                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Margin="0,4,0,0"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource GridBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer CanContentScroll="True" MaxHeight="300">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- TRIGGERS -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>

                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>

                        <!-- Mostrar placeholder cuando NO hay selección -->
                        <Trigger Property="SelectedIndex" Value="-1">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Mostrar placeholder cuando SelectedValue es null (ej. converter 0->null) -->
                        <Trigger Property="SelectedValue" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Mostrar placeholder cuando SelectedItem es null -->
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>

                        <!-- Mostrar placeholder cuando el sentinela (Id = 0) está seleccionado -->
                        <DataTrigger Binding="{Binding SelectedValue, RelativeSource={RelativeSource TemplatedParent}}">
                            <DataTrigger.Value>
                                <sys:Int64>0</sys:Int64>
                            </DataTrigger.Value>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="SelectedText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Ítems del desplegable -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background" Value="#FFF0F6F8"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#FFEFF6FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>







    <!-- ========= Toggle pill (CheckBox) ========= -->
    <Style x:Key="SwitchToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pista -->
                        <Border x:Name="Track" Width="44" Height="24"
                                Background="#E5E7EB"
                                BorderBrush="{DynamicResource GridBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"/>

                        <!-- Thumb -->
                        <Ellipse x:Name="Thumb" Width="20" Height="20" Fill="White" Margin="2"
                                 HorizontalAlignment="Left"/>

                        <!-- Texto (Content) -->
                        <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
