<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Existencias.ExistenciasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             Loaded="OnLoaded">

    <Grid>
        <!-- Listado principal -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInForm}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Titulo -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Existencias" Style="{StaticResource H1}"/>
                        <TextBlock Text="Gestione el inventario de suministros" Style="{StaticResource Caption}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource OutlineButton.Small}" Command="{Binding BuscarCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilterOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Filtros"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton.Small}" Command="{Binding ExportarExcelCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FileExcelOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource OutlineButton.Small}" Command="{Binding ExportarPdfCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding NuevoIngresoCommand}" Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CartPlus" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Registrar Ingreso"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource GhostButton}" Command="{Binding NuevaSalidaCommand}" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="TruckFast" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Registrar Salida"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Filtros -->
                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12"
                        BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="Codigo o nombre"
                                 Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding NivelOpciones}"
                                  SelectedItem="{Binding NivelSeleccionado, Mode=TwoWay}"
                                  DisplayMemberPath="Texto"
                                  Margin="12,0,0,0"
                                  Tag="Nivel"/>

                        <Button Grid.Column="2"
                                Style="{StaticResource GhostButton.Small}"
                                Command="{Binding LimpiarFiltrosAsyncCommand}"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="CloseCircleOutline" Width="16" Height="16" Margin="0,0,8,0"/>
                                <TextBlock Text="Limpiar filtros"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Tabla -->
                <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="12"
                        BorderBrush="{DynamicResource GridBorderBrush}" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              RowHeight="40"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              AlternatingRowBackground="#FFF3F4F6"
                              Style="{StaticResource GridTable2025}">

                        <!-- === estilos locales (encabezados + celdas centradas) === -->
                        <DataGrid.Resources>
                            <!-- Centrar contenido de celdas -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>

                            <!-- Encabezados centrados -->
                            <Style x:Key="CenteredColumnHeaderStyle" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#FFF9FAFB"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource GridBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF1F5F9"/>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Ascending">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="SortDirection" Value="Descending">
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Texto centrado para DataGridTextColumn -->
                            <Style x:Key="CenterCellTextBlock" TargetType="TextBlock">
                                <Setter Property="TextAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="CenterCellTextBox" TargetType="TextBox">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.ColumnHeaderStyle>
                            <StaticResource ResourceKey="CenteredColumnHeaderStyle"/>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codigo"
                                                Binding="{Binding Codigo}"
                                                Width="150"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                            <DataGridTextColumn Header="Nombre"
                                                Binding="{Binding Nombre}"
                                                Width="2*"
                                                MinWidth="220"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                            <DataGridTextColumn Header="Unidad"
                                                Binding="{Binding Unidad}"
                                                Width="120"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                            <DataGridTextColumn Header="Stock"
                                                Binding="{Binding StockActual}"
                                                Width="100"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                            <DataGridTextColumn Header="Nivel seguro"
                                                Binding="{Binding NivelSeguridad}"
                                                Width="120"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                            <DataGridTextColumn Header="Maximo"
                                                Binding="{Binding NivelMaximo}"
                                                Width="110"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>

                            <DataGridTemplateColumn Header="Alerta" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <iconPacks:PackIconMaterial Width="22" Height="22">
                                                <iconPacks:PackIconMaterial.Style>
                                                    <Style TargetType="iconPacks:PackIconMaterial">
                                                        <Setter Property="Kind" Value="CheckCircleOutline"/>
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NivelEstado}" Value="Critico">
                                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NivelEstado}" Value="Bajo">
                                                                <Setter Property="Kind" Value="AlertOutline"/>
                                                                <Setter Property="Foreground" Value="#F9A825"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NivelEstado}" Value="Seguro">
                                                                <Setter Property="Kind" Value="ShieldCheckOutline"/>
                                                                <Setter Property="Foreground" Value="#0277BD"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NivelEstado}" Value="Excedido">
                                                                <Setter Property="Kind" Value="TrendingUp"/>
                                                                <Setter Property="Foreground" Value="#6A1B9A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding NivelEstado}" Value="Desconocido">
                                                                <Setter Property="Kind" Value="HelpCircleOutline"/>
                                                                <Setter Property="Foreground" Value="#546E7A"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </iconPacks:PackIconMaterial.Style>
                                            </iconPacks:PackIconMaterial>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Proveedor"
                                                Binding="{Binding Proveedor}"
                                                Width="*"
                                                MinWidth="200"
                                                ElementStyle="{StaticResource CenterCellTextBlock}"
                                                EditingElementStyle="{StaticResource CenterCellTextBox}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Paginacion -->
                <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Mostrando" Style="{StaticResource Caption}"/>
                        <TextBlock Text=" " Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Items.Count}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                        <TextBlock Text=" de " Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Total}" Style="{StaticResource Caption}" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Style="{StaticResource OutlineButton.Small}"
                                Command="{Binding PagAnteriorCommand}"
                                IsEnabled="{Binding HasPrev}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ChevronLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Anterior"/>
                            </StackPanel>
                        </Button>
                        <Border Background="{DynamicResource CreamBrush}" CornerRadius="8" Padding="10,8" Margin="12,0,12,0">
                            <TextBlock Text="{Binding Page}" Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <Button Style="{StaticResource OutlineButton.Small}"
                                Command="{Binding PagSiguienteCommand}"
                                IsEnabled="{Binding HasNext}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Siguiente" Margin="0,0,6,0"/>
                                <iconPacks:PackIconMaterial Kind="ChevronRight" Width="16"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Formulario -->
        <ContentControl Content="{Binding FormVm}" Panel.ZIndex="5">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInForm}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Notificacion -->
        <Grid Panel.ZIndex="10">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotifyOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Rectangle Fill="#80000000"/>
            <Border Width="380"
                    Padding="24"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <iconPacks:PackIconMaterial Kind="CheckCircleOutline" Width="28" Height="28"/>
                        <TextBlock Text="{Binding NotifyTitle}" Style="{StaticResource H2}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NotifyMessage}" Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding CerrarNotificacionCommand}" Content="Aceptar"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
