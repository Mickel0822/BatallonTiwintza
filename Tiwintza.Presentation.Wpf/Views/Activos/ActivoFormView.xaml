<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Activos.ActivoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:conv="clr-namespace:Tiwintza.Presentation.Wpf.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <Style x:Key="FormField" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="FormField.Left" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
            <Setter Property="Margin" Value="0,0,12,16"/>
        </Style>
        <Style x:Key="FormField.Right" TargetType="StackPanel" BasedOn="{StaticResource FormField}">
            <Setter Property="Margin" Value="12,0,0,16"/>
        </Style>
        <Style x:Key="FormLabel" TargetType="TextBlock" BasedOn="{StaticResource Body}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:StringNullToVisibilityConverter x:Key="StringNullToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="18" MaxWidth="1100">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titulo -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Activos / Formulario" Style="{StaticResource Caption}" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}"/>
            <TextBlock Text="Registre o edite la información técnica y administrativa del activo." Style="{StaticResource Caption}"/>
        </StackPanel>

        <!-- Banner de validación/error -->
        <Border Grid.Row="0" Margin="0,0,0,8" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource ErrorLightBrush}"
                Visibility="{Binding FormValidationMessage, Converter={StaticResource StringNullToVisibility}}">
            <TextBlock Text="{Binding FormValidationMessage}" 
                       Foreground="{DynamicResource ErrorBrush}"
                       FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <TabItem Header="Generales">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Código de inventario"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding CodigoInventario, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         Tag="Ej: ACT-0001"/>
                                <TextBlock Text="{Binding CodigoInventarioError}"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           FontSize="12"
                                           Margin="2,4,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Caption}" Text="Código único del activo"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Descripción / especie"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         Tag="Nombre breve del activo"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Tipo"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Tipos}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding TipoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          Tag="Seleccione un tipo"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Estado"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Estados}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding EstadoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          Tag="Seleccione un estado"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Marca"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Ej: Dell"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Modelo"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="Ej: Latitude 5440"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Número de serie"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Material"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Valor unitario (USD)"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}, ValidatesOnNotifyDataErrors=True}"
                                         Tag="0.00"/>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Fecha de compra"/>
                                <DatePicker SelectedDate="{Binding FechaCompraDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Margin="0"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Proveedor" DockPanel.Dock="Left"/>
                                    <Button Style="{StaticResource GhostButton.Small}"
                                            Command="{Binding MostrarAgregarProveedorCommand}"
                                            Content="Agregar proveedor"
                                            Margin="12,0,0,0"
                                            DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Proveedores}"
                                          DisplayMemberPath="RazonSocial"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding ProveedorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Tag="Seleccione un proveedor"/>
                                <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource CreamBrush}" CornerRadius="8"
                                        Visibility="{Binding IsProveedorQuickAddVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="Nuevo proveedor" Style="{StaticResource FormLabel}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="RUC"/>
                                                <TextBox Style="{StaticResource InputTextBox}"
                                                         Text="{Binding NuevoProveedorRuc, UpdateSourceTrigger=PropertyChanged}"
                                                         MaxLength="13"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="Razón social"/>
                                                <TextBox Style="{StaticResource InputTextBox}"
                                                         Text="{Binding NuevoProveedorRazonSocial, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="Contacto"/>
                                                <TextBox Style="{StaticResource InputTextBox}"
                                                         Text="{Binding NuevoProveedorContacto, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="Teléfono"/>
                                                <TextBox Style="{StaticResource InputTextBox}"
                                                         Text="{Binding NuevoProveedorTelefono, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                                <TextBlock Style="{StaticResource FormLabel}" Text="Correo electrónico"/>
                                                <TextBox Style="{StaticResource InputTextBox}"
                                                         Text="{Binding NuevoProveedorEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Foreground="{DynamicResource ErrorBrush}" Text="{Binding ProveedorQuickAddError}" Margin="0,12,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ProveedorQuickAddError}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ProveedorQuickAddError}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Style="{StaticResource GhostButton.Small}"
                                                    Command="{Binding CancelarAgregarProveedorCommand}"
                                                    Content="Cancelar"
                                                    Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource PrimaryButton.Small}"
                                                    Command="{Binding GuardarProveedorRapidoCommand}"
                                                    Content="Guardar proveedor"
                                                    IsEnabled="{Binding PuedeGuardarProveedor}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Descripción"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="96"
                                         Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                <TextBlock Style="{StaticResource FormLabel}" Text="Observaciones"/>
                                <TextBox Style="{StaticResource InputTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="96"
                                         Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Ubicación">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource H3}" Text="Asignación actual" Margin="0,0,0,12"/>
                            <StackPanel Style="{StaticResource FormField}">
                                <TextBlock Style="{StaticResource FormLabel}">
                                    <Run Text="Área actual"/>
                                    <Run Text=" *" Foreground="{DynamicResource ErrorBrush}"/>
                                </TextBlock>
                                <ComboBox Style="{StaticResource InputComboBox}"
                                          ItemsSource="{Binding Areas}"
                                          DisplayMemberPath="Nombre"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding AreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                          Tag="Seleccione un área"/>
                                <TextBlock Style="{StaticResource Caption}" Text="Seleccione el área donde reside el activo"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Parámetros contables">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <CheckBox Content="Documento de autorización"
                                          IsChecked="{Binding DocumentoAutorizacion, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"/>
                                <TextBlock Style="{StaticResource Caption}"
                                           Text="Activa los parámetros contables al contar con el documento."/>
                            </StackPanel>

                            <Grid Visibility="{Binding DebeMostrarParametrosContables, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormField.Left}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Vida útil (meses)"/>
                                    <TextBox Style="{StaticResource InputTextBox}"
                                             Text="{Binding VidaUtilMeses, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Ej: 60"/>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{Binding VidaUtilEnAniosHint}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormField.Right}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Garantía (meses)"/>
                                    <TextBox Style="{StaticResource InputTextBox}"
                                             Text="{Binding GarantiaMeses, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="Ej: 12"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource FormField}">
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Depreciación mensual (USD)"/>
                                    <TextBox Style="{StaticResource InputTextBox}"
                                             Text="{Binding DepreciacionMensual, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                                             Tag="0.00"/>
                                    <TextBlock Style="{StaticResource Caption}"
                                               Text="{Binding DepreciacionAnualHint}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Movimientos">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Formulario de traslado (solo en modo edición) -->
                        <Border Grid.Row="0" Padding="16" Background="{DynamicResource CreamBrush}" CornerRadius="8" Margin="0,0,0,16"
                                Visibility="{Binding EsEdicion, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="Trasladar activo a otra área" Style="{StaticResource FormLabel}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Área destino *" Style="{StaticResource Caption}"/>
                                        <ComboBox Style="{StaticResource InputComboBox}"
                                                  ItemsSource="{Binding Areas}"
                                                  DisplayMemberPath="Nombre"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding NuevoMovimientoAreaDestinoId, Mode=TwoWay}"
                                                  Tag="Seleccione el área destino"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Observación" Style="{StaticResource Caption}"/>
                                        <TextBox Style="{StaticResource InputTextBox}"
                                                 Text="{Binding NuevoMovimientoObservacion, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Motivo del traslado"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding TrasladarActivoCommand}"
                                            IsEnabled="{Binding PuedeTrasladar}"
                                            VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Trasladar"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="1" Text="Historial de movimientos del activo"
                                   Style="{StaticResource FormLabel}"/>

                        <DataGrid Grid.Row="2" Margin="0,12,0,0"
                                  ItemsSource="{Binding Movimientos}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Fecha" Width="120">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Fecha" Converter="{StaticResource DateOnlyToString}"/>
                                    </DataGridTextColumn.Binding>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Área origen" Binding="{Binding AreaOrigen}" Width="*"/>
                                <DataGridTextColumn Header="Área destino" Binding="{Binding AreaDestino}" Width="*"/>
                                <DataGridTextColumn Header="Observación" Binding="{Binding Observacion}" Width="2*"/>
                                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="No existen movimientos registrados."
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Movimientos.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource GhostButton.Small}"
                        Command="{Binding CancelarCommand}"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding GuardarCommand}"
                        IsEnabled="{Binding PuedeGuardar}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,6,0"/>
                        <TextBlock Text="Guardar"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="99" Background="#80FFFFFF" 
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" 
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="Guardando..." Margin="0,8,0,0" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
