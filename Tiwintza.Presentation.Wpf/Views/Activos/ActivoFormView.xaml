<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Activos.ActivoFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton.Small}"
                        Command="{Binding VolverCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" Margin="0,0,6,0"/>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource H1}" Margin="12,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource GhostButton.Small}"
                        Command="{Binding CancelarCommand}" Margin="0,0,8,0">
                    <TextBlock Text="Cancelar"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding GuardarAsyncCommand}"
                        IsEnabled="{Binding PuedeGuardar}">
                    <TextBlock Text="Guardar"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Contenedor principal -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <TabControl>
                <!-- === Generales === -->
                <TabItem Header="Generales">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Código / Tipo -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Código de Inventario *" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding CodigoInventario, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Código único del activo"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Tipo *" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Tipos}" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                      SelectedValue="{Binding TipoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <!-- Nombre / Estado -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Descripción/Especie *" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Estado *" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Estados}" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                      SelectedValue="{Binding EstadoId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <!-- Marca / Modelo -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Marca" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Marca, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Modelo" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Modelo, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Serie / Material -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Número de Serie" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Serie, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Material" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding Material, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Valor / Fecha -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Valor Unitario (USD) *" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}, ValidatesOnNotifyDataErrors=True}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Fecha de Compra" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding FechaCompraDateTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Proveedor -->
                        <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <TextBlock Text="Proveedor" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Proveedores}" DisplayMemberPath="RazonSocial" SelectedValuePath="Id"
                                      SelectedValue="{Binding ProveedorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Descripción -->
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <TextBlock Text="Descripción" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}" AcceptsReturn="True" Height="68"
                                     Text="{Binding Descripcion, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Observaciones -->
                        <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <TextBlock Text="Observaciones" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}" AcceptsReturn="True" Height="68"
                                     Text="{Binding Observaciones, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- === Ubicación === -->
                <TabItem Header="Ubicación">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Área Actual *" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Areas}" DisplayMemberPath="Nombre" SelectedValuePath="Id"
                                      SelectedValue="{Binding AreaId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="Seleccione el área donde reside el activo"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- === Parámetros Contables === -->
                <TabItem Header="Parámetros Contables">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,0,8">
                            <TextBlock Text="Vida Útil (meses)" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding VidaUtilMeses, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource Caption}" 
                                       Text="{Binding VidaUtilEnAniosHint}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,0,8">
                            <TextBlock Text="Garantía (meses)" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding GarantiaMeses, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,8">
                            <TextBlock Text="Depreciación Mensual (USD)" FontWeight="SemiBold"/>
                            <TextBox Style="{StaticResource InputTextBox}"
                                     Text="{Binding DepreciacionMensual, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"/>
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="{Binding DepreciacionAnualHint}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Barra inferior (duplico acciones por UX) -->
        <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton.Small}" Command="{Binding VolverCommand}" DockPanel.Dock="Left">
                <TextBlock Text="← Volver"/>
            </Button>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource GhostButton.Small}" Command="{Binding CancelarCommand}" Margin="0,0,8,0">
                    <TextBlock Text="Cancelar"/>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding GuardarAsyncCommand}"
                        IsEnabled="{Binding PuedeGuardar}">
                    <TextBlock Text="Guardar"/>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
