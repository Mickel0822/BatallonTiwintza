<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Activos.ActivoTrasladoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Activos / Traslado" Style="{StaticResource Caption}" Foreground="{DynamicResource MutedBrush}"/>
            <TextBlock Text="Traslado de Activo" Style="{StaticResource H1}"/>
            <TextBlock Text="Registre un movimiento físico de activos entre áreas." Style="{StaticResource Caption}"/>
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource Card}"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Seleccionado"
                           Style="{StaticResource Caption}"/>
                <TextBlock Text="{Binding Codigo}"
                           Style="{StaticResource H3}"/>
                <TextBlock Text="{Binding Nombre}"
                           Style="{StaticResource Body}"/>

                <Separator Margin="0,18"/>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Área destino" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <ComboBox Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding Areas}"
                              DisplayMemberPath="Nombre"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding AreaDestinoId, Mode=TwoWay}"
                              Tag="Seleccione un área"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="Fecha de traslado" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <DatePicker SelectedDate="{Binding Fecha, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Observación" Style="{StaticResource Body}" FontWeight="SemiBold"/>
                    <TextBox Style="{StaticResource InputTextBox}"
                             Text="{Binding Observacion, Mode=TwoWay}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="72"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    >
            <Button Style="{StaticResource GhostButton.Small}"
                    Command="{Binding CancelarCommand}"
                    Content="Cancelar" Margin="0,0,8,0"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Command="{Binding TrasladarCommand}"
                    IsEnabled="{Binding PuedeTrasladar}"
                    Content="Trasladar"/>
        </StackPanel>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="99" Background="#80FFFFFF" 
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" 
                Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="Procesando..." Margin="0,8,0,0" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>