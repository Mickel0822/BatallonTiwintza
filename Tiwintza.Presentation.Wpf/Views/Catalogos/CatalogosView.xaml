<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Catalogos.CatalogosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Tiwintza.Presentation.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNullToVisibilityConverter x:Key="StringNullToVisibility"/>

        <!-- Estilo de pestañas tipo chip -->
        <Style x:Key="ChipTabItem" TargetType="TabItem">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de acción en tabla -->
        <Style x:Key="TableActionButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Catálogos" Style="{StaticResource H1}"/>
                <TextBlock Text="Administre los catálogos del sistema" 
                           Style="{StaticResource Caption}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RecargarCommand}"
                    Style="{StaticResource OutlineButton}"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Refresh" 
                                                Width="18" 
                                                Height="18"/>
                    <TextBlock Text="Actualizar" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- KPI Cards -->
        <UniformGrid Grid.Row="1" 
                     Rows="1" 
                     Margin="32,24,32,24">
            <!-- Áreas -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,12,0"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" 
                            Height="48"
                            Background="{DynamicResource PrimarySoftBrush}"
                            CornerRadius="12">
                        <iconPacks:PackIconMaterial Kind="OfficeBuilding"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" 
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Áreas registradas"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Areas.Count}"
                                   Style="{StaticResource H2}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Tipos -->
            <Border Style="{StaticResource Card}"
                    Margin="0,0,12,0"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" 
                            Height="48"
                            Background="{DynamicResource PrimarySoftBrush}"
                            CornerRadius="12">
                        <iconPacks:PackIconMaterial Kind="FormatListBulleted"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" 
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Tipos de bien"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Tipos.Count}"
                                   Style="{StaticResource H2}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Proveedores -->
            <Border Style="{StaticResource Card}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="48" 
                            Height="48"
                            Background="{DynamicResource PrimarySoftBrush}"
                            CornerRadius="12">
                        <iconPacks:PackIconMaterial Kind="HandshakeOutline"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource PrimaryBrush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" 
                                Margin="16,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="Proveedores"
                                   Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Proveedores.Count}"
                                   Style="{StaticResource H2}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Contenido con pestañas -->
        <Border Grid.Row="2" 
                Style="{StaticResource Card}"
                Margin="32,0,32,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Error message -->
                <Border Grid.Row="0"
                        Background="{DynamicResource StatusDangerBrush}"
                        BorderBrush="{DynamicResource ErrorBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="AlertCircle" 
                                                    Width="20" 
                                                    Height="20"
                                                    Foreground="{DynamicResource ErrorBrush}"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"/>
                    </StackPanel>
                </Border>

                <!-- TabControl con scroll -->
                <TabControl Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource ChipTabItem}">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="HorizontalAlignment" Value="Left"/>
                        </Style>
                    </TabControl.Resources>

                    <!-- ÁREAS -->
                    <TabItem Header="Áreas">
                        <Grid Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Formulario agregar -->
                            <Border Grid.Row="0"
                                    Background="#F9FAFB"
                                    BorderBrush="{DynamicResource GridBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding NuevoAreaNombre, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             Tag="Nombre del área"
                                             MaxWidth="400"
                                             HorizontalAlignment="Left"/>

                                    <Button Grid.Column="1"
                                            Content="+ Añadir"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AgregarAreaCommand}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Tabla -->
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Areas}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource GridBorderBrush}"
                                      RowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" 
                                                        Binding="{Binding Id}" 
                                                        Width="100"/>
                                    <DataGridTextColumn Header="NOMBRE" 
                                                        Binding="{Binding Nombre}" 
                                                        Width="*"/>
                                    <DataGridTemplateColumn Header="ACCIONES" 
                                                            Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.AbrirEditarAreaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Editar">
                                                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.EliminarAreaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="8,0,0,0"
                                                            ToolTip="Eliminar">
                                                        <iconPacks:PackIconMaterial Kind="Delete"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource ErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TIPOS -->
                    <TabItem Header="Tipos">
                        <Grid Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#F9FAFB"
                                    BorderBrush="{DynamicResource GridBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Text="{Binding NuevoTipoNombre, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBox}"
                                             Tag="Nombre del tipo"
                                             MaxWidth="400"
                                             HorizontalAlignment="Left"/>

                                    <Button Grid.Column="1"
                                            Content="+ Añadir"
                                            Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AgregarTipoCommand}"
                                            Margin="12,0,0,0"/>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Tipos}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource GridBorderBrush}"
                                      RowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" 
                                                        Binding="{Binding Id}" 
                                                        Width="100"/>
                                    <DataGridTextColumn Header="NOMBRE" 
                                                        Binding="{Binding Nombre}" 
                                                        Width="*"/>
                                    <DataGridTemplateColumn Header="ACCIONES" 
                                                            Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.AbrirEditarTipoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Editar">
                                                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.EliminarTipoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="8,0,0,0"
                                                            ToolTip="Eliminar">
                                                        <iconPacks:PackIconMaterial Kind="Delete"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource ErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    
                    <!-- PROVEEDORES -->
                    <TabItem Header="Proveedores">
                        <Grid Margin="0,24,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="#F9FAFB"
                                    BorderBrush="{DynamicResource GridBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16"
                                    Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Text="{Binding NuevoProveedor.Ruc, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"
                                                 Tag="RUC"
                                                 Margin="0,0,8,0"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding NuevoProveedor.RazonSocial, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"
                                                 Tag="Razón social"
                                                 Margin="0,0,8,0"/>

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding NuevoProveedor.Contacto, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"
                                                 Tag="Contacto"/>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox Text="{Binding NuevoProveedor.Telefono, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"
                                                 Tag="Teléfono"
                                                 Margin="0,0,8,0"/>

                                        <TextBox Grid.Column="1"
                                                 Text="{Binding NuevoProveedor.Email, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputTextBox}"
                                                 Tag="Email"
                                                 Margin="0,0,8,0"/>

                                        <Button Grid.Column="2"
                                                Content="+ Añadir"
                                                Style="{StaticResource PrimaryButton}"
                                                Command="{Binding AgregarProveedorCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Proveedores}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource GridBorderBrush}"
                                      RowHeight="48">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="RUC" 
                                                        Binding="{Binding Ruc}" 
                                                        Width="140"/>
                                    <DataGridTextColumn Header="RAZÓN SOCIAL" 
                                                        Binding="{Binding RazonSocial}" 
                                                        Width="*"/>
                                    <DataGridTextColumn Header="CONTACTO" 
                                                        Binding="{Binding Contacto}" 
                                                        Width="140"/>
                                    <DataGridTextColumn Header="TELÉFONO" 
                                                        Binding="{Binding Telefono}" 
                                                        Width="120"/>
                                    <DataGridTemplateColumn Header="ACCIONES" 
                                                            Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" 
                                                            HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.AbrirEditarProveedorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Editar">
                                                        <iconPacks:PackIconMaterial Kind="Pencil"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource PrimaryBrush}"/>
                                                    </Button>
                                                    <Button Style="{StaticResource TableActionButton}"
                                                            Command="{Binding DataContext.EliminarProveedorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="8,0,0,0"
                                                            ToolTip="Eliminar">
                                                        <iconPacks:PackIconMaterial Kind="Delete"
                                                                                    Width="16"
                                                                                    Height="16"
                                                                                    Foreground="{DynamicResource ErrorBrush}"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Diálogo Editar Área -->
        <Grid Grid.RowSpan="3" 
              Panel.ZIndex="100"
              Visibility="{Binding IsAreaDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80000000"/>
            <Border Width="400"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Editar área" Style="{StaticResource H3}"/>
                    <TextBox Text="{Binding AreaEdicion.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Tag="Nombre del área"
                             Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding CancelarEditarAreaCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarAreaCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diálogo Editar Tipo -->
        <Grid Grid.RowSpan="3" 
              Panel.ZIndex="100"
              Visibility="{Binding IsTipoDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80000000"/>
            <Border Width="400"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Editar tipo" Style="{StaticResource H3}"/>
                    <TextBox Text="{Binding TipoEdicion.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             Tag="Nombre del tipo"
                             Margin="0,16,0,0"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding CancelarEditarTipoCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarTipoCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Diálogo Editar Proveedor -->
        <Grid Grid.RowSpan="3" 
              Panel.ZIndex="100"
              Visibility="{Binding IsProveedorDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80000000"/>
            <Border Width="520"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Editar proveedor" Style="{StaticResource H3}"/>
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Row="0" Grid.Column="0"
                                 Text="{Binding ProveedorEdicion.Ruc, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="RUC"
                                 Margin="0,0,8,12"/>

                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding ProveedorEdicion.RazonSocial, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="Razón social"
                                 Margin="0,0,0,12"/>

                        <TextBox Grid.Row="1" Grid.Column="0"
                                 Text="{Binding ProveedorEdicion.Contacto, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="Contacto"
                                 Margin="0,0,8,12"/>

                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding ProveedorEdicion.Telefono, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="Teléfono"
                                 Margin="0,0,0,12"/>

                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                 Text="{Binding ProveedorEdicion.Email, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="Email"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource OutlineButton}"
                                Command="{Binding CancelarEditarProveedorCommand}"
                                Margin="0,0,8,0"/>
                        <Button Content="Guardar"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding GuardarProveedorCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Notificación -->
        <Grid Grid.RowSpan="3" 
              Panel.ZIndex="200"
              Visibility="{Binding IsNotifyOpen, Converter={StaticResource BoolToVisibility}}">
            <Rectangle Fill="#80000000"/>
            <Border Width="440"
                    Background="White"
                    CornerRadius="12"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Width="48" Height="48" 
                                CornerRadius="24"
                                VerticalAlignment="Top">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource StatusSuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotifyIsError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource StatusDangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <iconPacks:PackIconMaterial Width="24" Height="24"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial.Style>
                                    <Style TargetType="iconPacks:PackIconMaterial">
                                        <Setter Property="Kind" Value="CheckCircle"/>
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotifyIsError}" Value="True">
                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </iconPacks:PackIconMaterial.Style>
                            </iconPacks:PackIconMaterial>
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding NotifyTitle}" 
                                       Style="{StaticResource H3}"/>
                            <TextBlock Text="{Binding NotifyMessage}" 
                                       Style="{StaticResource Body}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Aceptar"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CerrarNotificacionCommand}"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>