<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Auditoria.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Tiwintza.Presentation.Wpf.ViewModels.Auditoria"
             xmlns:conv="clr-namespace:Tiwintza.Presentation.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1200">

    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="AccionChip" TargetType="Border">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{StaticResource StatusInfoBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Accion}" Value="Creacion">
                    <Setter Property="Background" Value="{StaticResource StatusSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Actualizacion">
                    <Setter Property="Background" Value="{StaticResource StatusInfoBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Accion}" Value="Baja">
                    <Setter Property="Background" Value="{StaticResource StatusDangerBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditoriaDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="24,16,24,24">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Auditoria" Style="{StaticResource H1}"/>
                <iconPacks:PackIconMaterial Kind="HelpCircle" Width="20" Height="20" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"
                                            ToolTip="Este módulo registra automáticamente todas las acciones críticas del sistema (Ingresos, Salidas, Cambios). Utilice los filtros de Fecha y Usuario para rastrear movimientos históricos. Exporte a Excel para análisis detallado."/>
            </StackPanel>
            <TextBlock Text="Consulte el historial de acciones realizadas en el sistema" Style="{StaticResource Caption}"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="24,0,24,24" Style="{StaticResource Card}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Rango de fechas -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Desde" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding FechaInicio}" Width="140"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Hasta" Style="{StaticResource FilterLabel}"/>
                    <DatePicker SelectedDate="{Binding FechaFin}" Width="140"/>
                </StackPanel>

                <!-- Filtros de selección -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,12">
                    <TextBlock Text="Usuario" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Usuarios}" SelectedItem="{Binding UsuarioSeleccionado}" DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,12">
                    <TextBlock Text="Entidad" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Entidades}" SelectedItem="{Binding EntidadSeleccionada}" DisplayMemberPath="Display"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,12,12">
                    <TextBlock Text="Acción" Style="{StaticResource FilterLabel}"/>
                    <ComboBox ItemsSource="{Binding Acciones}" SelectedItem="{Binding AccionSeleccionada}" DisplayMemberPath="Display"/>
                </StackPanel>

                <!-- Búsqueda y Botón -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,12,0">
                    <TextBlock Text="Buscar por ID o resumen" Style="{StaticResource FilterLabel}"/>
                    <TextBox Text="{Binding Texto, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding BuscarCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="5" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding BuscarCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Buscar"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="24,0,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Eventos (Event Centric) -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="24,24,24,12">
                        <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                            <TextBlock Text="Cronología de Eventos" Style="{StaticResource H3}"/>
                            <TextBlock Text="Actividad agrupada por evento de negocio" Style="{StaticResource Caption}"/>
                        </StackPanel>
                        <Button Content="Exportar" Style="{StaticResource OutlineButton}" Command="{Binding ExportarCommand}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding Eventos}" 
                             SelectedItem="{Binding EventoSeleccionado}"
                             BorderThickness="0" 
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                         <ListBox.ItemContainerStyle>
                             <Style TargetType="ListBoxItem">
                                 <Setter Property="Padding" Value="0"/>
                                 <Setter Property="Margin" Value="0,0,0,8"/>
                                 <Setter Property="Background" Value="Transparent"/>
                                 <Setter Property="Cursor" Value="Hand"/>
                                 <Setter Property="Template">
                                     <Setter.Value>
                                         <ControlTemplate TargetType="ListBoxItem">
                                             <Border Background="{TemplateBinding Background}" 
                                                     BorderBrush="{StaticResource GridBorderBrush}" 
                                                     BorderThickness="1" 
                                                     CornerRadius="8" 
                                                     Padding="16,12">
                                                 <ContentPresenter/>
                                             </Border>
                                             <ControlTemplate.Triggers>
                                                 <Trigger Property="IsSelected" Value="True">
                                                     <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                                                     <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                 </Trigger>
                                                 <Trigger Property="IsMouseOver" Value="True">
                                                     <Setter Property="Background" Value="#F8FAFC"/>
                                                 </Trigger>
                                             </ControlTemplate.Triggers>
                                         </ControlTemplate>
                                     </Setter.Value>
                                 </Setter>
                             </Style>
                         </ListBox.ItemContainerStyle>
                         <ListBox.ItemTemplate>
                             <DataTemplate>
                                 <Grid>
                                     <Grid.ColumnDefinitions>
                                         <ColumnDefinition Width="Auto"/>
                                         <ColumnDefinition Width="*"/>
                                     </Grid.ColumnDefinitions>
                                     
                                     <!-- Icono Evento -->
                                     <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#EEF2FF" Margin="0,0,16,0">
                                         <iconPacks:PackIconMaterial Kind="{Binding IconKind}" Foreground="{StaticResource PrimaryBrush}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                     </Border>
                                     
                                     <!-- Contenido -->
                                     <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                         <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource OnSurfaceBrush}"/>
                                         <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedBrush}"/>
                                     </StackPanel>
                                 </Grid>
                             </DataTemplate>
                         </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Panel Detalle Narrativo -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="16,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Narrativo -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24" CornerRadius="8,8,0,0"
                            BorderBrush="{StaticResource GridBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <iconPacks:PackIconMaterial Kind="{Binding EventoSeleccionado.IconKind}" Foreground="{StaticResource PrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding EventoSeleccionado.Title}" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Text="{Binding EventoSeleccionado.Description}" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,16" FontSize="15" LineHeight="22"/>
                            
                            <!-- Nota Post-it Observacion -->
                            <Border Background="#FFFBEEB0" CornerRadius="4" Padding="12" Margin="0,0,0,0" 
                                    Visibility="{Binding EventoSeleccionado.Observacion, Converter={StaticResource NullToVisibility}}">
                                <DockPanel>
                                    <iconPacks:PackIconMaterial Kind="FormatQuoteOpen" Foreground="#B7950B" Width="16" Height="16" DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Text="{Binding EventoSeleccionado.Observacion}" FontStyle="Italic" Foreground="#7D6608" TextWrapping="Wrap"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Lista de Propiedades Consolidada (Humanizada) -->
                    <ScrollViewer Grid.Row="1" Padding="24">
                        <StackPanel>
                            <TextBlock Text="Datos del Evento" Style="{StaticResource H3}" Margin="0,0,0,16" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            
                            <ItemsControl ItemsSource="{Binding EventoSeleccionado.DetallePropiedades}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,16,16" MinWidth="180" MaxWidth="400">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding Value}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- Mensaje Vacío -->
                    <Grid Grid.RowSpan="2" Background="White" Visibility="{Binding EventoSeleccionado, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                             <iconPacks:PackIconMaterial Kind="History" Width="48" Height="48" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                             <TextBlock Text="Seleccione un evento para ver la historia completa" Style="{StaticResource Body}" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="24,0,24,24" LastChildFill="False">
            <TextBlock Text="{Binding Page}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Anterior" Style="{StaticResource OutlineButton}" Command="{Binding PaginaAnteriorCommand}" Margin="0,0,8,0"/>
                <Button Content="Siguiente" Style="{StaticResource OutlineButton}" Command="{Binding PaginaSiguienteCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding Total, StringFormat='Total: {0} registros'}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Notificacion -->

        <Grid Panel.ZIndex="20" Grid.RowSpan="4">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>

                        <DataTrigger Binding="{Binding IsNotifyOpen}" Value="True">

                            <Setter Property="Visibility" Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>

            <Rectangle Fill="#80000000"/>

            <Border Width="420" Padding="24" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                        <iconPacks:PackIconMaterial Width="28" Height="28">

                            <iconPacks:PackIconMaterial.Style>

                                <Style TargetType="iconPacks:PackIconMaterial">

                                    <Setter Property="Kind" Value="CheckCircleOutline"/>

                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding NotifyIsError}" Value="True">

                                            <Setter Property="Kind" Value="AlertCircleOutline"/>

                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </iconPacks:PackIconMaterial.Style>

                        </iconPacks:PackIconMaterial>

                        <TextBlock Text="{Binding NotifyTitle}" Margin="8,0,0,0">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock" BasedOn="{StaticResource H3}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding NotifyIsError}" Value="True">

                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>

                    </StackPanel>

                    <TextBlock Text="{Binding NotifyMessage}" Style="{StaticResource Body}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">

                        <Button Content="Aceptar" Command="{Binding CerrarNotificacionCommand}" Style="{StaticResource PrimaryButton}" Padding="16,6"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="99" Background="#80FFFFFF" 
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" 
                Panel.ZIndex="300">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="Cargando..." Margin="0,8,0,0" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>




