<Window x:Class="Tiwintza.Presentation.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:diag="clr-namespace:System.Diagnostics;assembly=WindowsBase"
        Title="Iniciar sesión - Control de Activos"
        Height="600" Width="980"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource AppGradient}"
        diag:PresentationTraceSources.TraceLevel="High">
    
    

    <Grid Margin="36" diag:PresentationTraceSources.TraceLevel="High">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <!-- Branding -->
        <Border Grid.Column="0"
                CornerRadius="18"
                Padding="36"
                Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Batallón Tiwintza"
                               Foreground="White"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <Image Source="/Assets/tiwintza-logo.png"
                           Width="318" Height="233" Stretch="Uniform">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45"/>
                        </Image.Effect>
                    </Image>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="Sistema de Control de Activos &amp; Existencias"
                           Foreground="White" FontSize="20" FontWeight="SemiBold"
                           TextWrapping="Wrap" TextAlignment="Center"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="© 2025"
                           Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Tarjeta de login -->
        <Border Grid.Column="1" Style="{DynamicResource Card}"
                diag:PresentationTraceSources.TraceLevel="High">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Bienvenido" Style="{DynamicResource H2}"/>
                    <TextBlock Text="Inicia sesión con tus credenciales"
                               Style="{DynamicResource Caption}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0"
                            diag:PresentationTraceSources.TraceLevel="High">
                    <TextBlock Text="Usuario" FontWeight="SemiBold"/>
                    <TextBox Style="{DynamicResource InputTextBox}"
                             Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"
                             diag:PresentationTraceSources.TraceLevel="High"/>

                    <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <Grid>
                        <PasswordBox x:Name="PwdBox"
                                     Style="{DynamicResource InputPasswordBox}"
                                     Padding="10,6,44,6"
                                     PasswordChanged="PasswordBox_OnPasswordChanged"
                                     diag:PresentationTraceSources.TraceLevel="High"/>
                        <TextBox x:Name="PwdPlainBox"
                                 Style="{DynamicResource InputTextBox}"
                                 Padding="10,6,44,6"
                                 Text="{Binding Clave, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"
                                 TextChanged="PwdPlainBox_OnTextChanged"
                                 diag:PresentationTraceSources.TraceLevel="High"/>
                        <ToggleButton x:Name="TogglePasswordVisibility"
                                      Style="{DynamicResource PasswordToggleButton}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"
                                      ToolTip="Mostrar contraseña"
                                      ToolTipService.ShowDuration="4000"
                                      Checked="TogglePasswordVisibility_OnChecked"
                                      Unchecked="TogglePasswordVisibility_OnUnchecked"/>
                    </Grid>

                    <CheckBox Content="Recordarme"
                              IsChecked="{Binding Recordarme}"
                              Margin="0,10,0,0"
                              Foreground="{DynamicResource OnSurfaceBrush}"
                              diag:PresentationTraceSources.TraceLevel="High"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{DynamicResource PrimaryButton}" MinWidth="120"
                                Command="{Binding LoginCommand}" Content="Ingresar"
                                diag:PresentationTraceSources.TraceLevel="High"/>
                        <Button Style="{DynamicResource GhostButton}" MinWidth="120" Margin="10,0,0,0"
                                Command="{Binding SalirCommand}" Content="Salir"
                                diag:PresentationTraceSources.TraceLevel="High"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Mensaje}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ErrorBrush}" Margin="2,10,0,0"
                               diag:PresentationTraceSources.TraceLevel="High"/>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="¿Olvidaste tu contraseña? Contacta a Sistemas"
                           Style="{DynamicResource Caption}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
