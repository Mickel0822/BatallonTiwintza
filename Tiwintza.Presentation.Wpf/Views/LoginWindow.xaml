<Window x:Class="Tiwintza.Presentation.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Iniciar sesión - Control de Activos" Height="600" Width="980"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource AppGradient}">
    <Grid Margin="36">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="520"/>
        </Grid.ColumnDefinitions>

        <!-- Branding -->
        <Border CornerRadius="18" Grid.Column="0" Padding="36" Background="#141A2B">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Batallón Tiwintza"
                               Foreground="White"
                               FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="1"/>
                    <Image Source="/Assets/tiwintza-logo.png"
                           Width="318" Height="233" Stretch="Uniform" Margin="0,0,10,0">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.45"/>
                        </Image.Effect>
                    </Image>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Sistema de Control de Activos &amp; Existencias"
                     Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="© 2025" Foreground="#94A3B8" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Tarjeta de login -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Bienvenido" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Inicia sesión con tus credenciales" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBox Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,10,0,0" Foreground="#111827"/>
                    <PasswordBox x:Name="PwdBox" PasswordChanged="PasswordBox_OnPasswordChanged" Padding="12" Margin="0,8,0,0">
                        <PasswordBox.Resources>
                            <Style TargetType="{x:Type PasswordBox}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type PasswordBox}">
                                            <Border CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1" Background="White">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="6"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <CheckBox Content="Recordarme" IsChecked="{Binding Recordarme}" Margin="0,10,0,0" Foreground="#374151"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButton}" MinWidth="120"
                    Command="{Binding LoginCommand}" Content="Ingresar"/>
                        <Button Style="{StaticResource GhostButton}" MinWidth="120" Margin="10,0,0,0"
                    Command="{Binding SalirCommand}" Content="Salir"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Mensaje}" Foreground="#DC2626" Margin="2,10,0,0" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="¿Olvidaste tu contraseña? Contacta a Sistemas"
                   Foreground="#6B7280" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
