<UserControl x:Class="Tiwintza.Presentation.Wpf.Views.Configuracion.ConfiguracionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Tiwintza.Presentation.Wpf.Converters"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1080">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:StringNullToVisibilityConverter x:Key="StringNullToVisibility"/>
    </UserControl.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Configuración" Style="{StaticResource H1}"/>
            <TextBlock Text="Administre los usuarios y roles del sistema" Style="{StaticResource Caption}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FFFDE8E4"
                    BorderBrush="{DynamicResource ErrorBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNullToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="AlertCircleOutline" Width="20" Height="20" Foreground="{DynamicResource ErrorBrush}"/>
                    <TextBlock Text="{Binding ErrorMessage}" Margin="8,0,0,0" Foreground="{DynamicResource ErrorBrush}" Style="{StaticResource Caption}"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    BorderBrush="{DynamicResource GridBorderBrush}"
                    BorderThickness="1">
				
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Nuevo usuario"
                                    Command="{Binding AbrirNuevoUsuarioCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button Content="Recargar"
                                    Command="{Binding RecargarCommand}"
                                    Style="{StaticResource OutlineButton}"
                                    Margin="12,0,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Usuarios}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              Style="{StaticResource GridTable2025}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre completo" Binding="{Binding NombreCompleto}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="160"/>
                            <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="200"/>
                            <DataGridTextColumn Header="Roles" Binding="{Binding Roles}" Width="200"/>
                            <DataGridTextColumn Header="Activo" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridTextColumn Header="Creado" Binding="{Binding CreadoEn}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <Grid Panel.ZIndex="20" Grid.RowSpan="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNuevoUsuarioAbierto}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="#40191F25"
                    CornerRadius="16"
                    Padding="32">
                
                <Border Width="480"
                        Background="White"
                        CornerRadius="16"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{DynamicResource GridBorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Registrar usuario" Style="{StaticResource H3}"/>
                        <TextBlock Text="Complete la información para crear un nuevo usuario"
                                   Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource MutedBrush}"/>

                        <Grid Margin="0,20,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="Nombre completo"
                                     Text="{Binding NuevoNombreCompleto, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,12,12"/>

                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="Usuario"
                                     Text="{Binding NuevoUsername, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Row="1" Grid.ColumnSpan="2"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="Correo electrónico (opcional)"
                                     Text="{Binding NuevoEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,12"/>

                            <PasswordBox x:Name="NewUserPasswordBox"
                                         Grid.Row="2" Grid.Column="0"
                                         Margin="0,0,12,0"
										 Tag="Contraseña"
                                         Style="{StaticResource InputPasswordBox}"
                                         PasswordChanged="PasswordBox_OnPasswordChanged"
                                         ToolTip="Contraseña"/>

                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Grid.Row="2" Grid.Column="1"
										 Tag="Confirmar Contraseña"
                                         Style="{StaticResource InputPasswordBox}"
                                         PasswordChanged="ConfirmPasswordBox_OnPasswordChanged"
                                         ToolTip="Confirmar contraseña"/>
                        </Grid>

                        <ComboBox ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding RolSeleccionado}"
                                  Style="{StaticResource InputComboBox}"
                                  Tag="Rol del usuario"/>

                        <CheckBox Content="Usuario activo"
                                  IsChecked="{Binding NuevoUsuarioActivo}"
                                  Margin="0,12,0,0"/>

                        <Border Background="#FFFDE8E4"
                                BorderBrush="{DynamicResource ErrorBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                Margin="0,12,0,0"
                                Visibility="{Binding MensajeDialogo, Converter={StaticResource StringNullToVisibility}}">
                            <TextBlock Text="{Binding MensajeDialogo}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Style="{StaticResource Caption}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="Cancelar"
                                    Command="{Binding CerrarNuevoUsuarioCommand}"
                                    Style="{StaticResource GhostButton.Small}"/>
                            <Button Content="Guardar"
                                    Command="{Binding CrearNuevoUsuarioCommand}"
                                    Margin="12,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Padding" Value="18,8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDialogBusy}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
