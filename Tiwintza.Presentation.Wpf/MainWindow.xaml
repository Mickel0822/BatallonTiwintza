<Window x:Class="Tiwintza.Presentation.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control de Activos - Tiwintza" Height="720" Width="1100">
    <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
            <Button Content="Cargar Áreas" Command="{Binding AreasVM.CargarCommand}" Margin="0,0,8,0"/>
        </StackPanel>
        <DataGrid ItemsSource="{Binding AreasVM.Areas}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding id}" Width="100"/>
                <DataGridTextColumn Header="Área" Binding="{Binding nombre}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
