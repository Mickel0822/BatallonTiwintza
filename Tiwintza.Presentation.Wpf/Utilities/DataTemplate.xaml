<!-- Styles/ViewTemplates.xaml -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:Tiwintza.Presentation.Wpf.Views"
    xmlns:viewsAct="clr-namespace:Tiwintza.Presentation.Wpf.Views.Activos"
    xmlns:vmDash="clr-namespace:Tiwintza.Presentation.Wpf.ViewModels"
    xmlns:vmAct="clr-namespace:Tiwintza.Presentation.Wpf.ViewModels.Activos">

    <!-- Dashboard -->
    <DataTemplate DataType="{x:Type vmDash:DashboardViewModel}">
        <views:DashboardView/>
    </DataTemplate>

    <!-- Activos (nuevo) -->
    <DataTemplate DataType="{x:Type vmAct:ActivosListViewModel}">
        <viewsAct:ActivosView/>
    </DataTemplate>

    <!-- ❌ quita cualquier DataTemplate que apunte a vm:ActivosViewModel antiguo -->
    <!-- Formularios de Activos -->
    <DataTemplate DataType="{x:Type vmAct:ActivoFormViewModel}">
        <viewsAct:ActivoFormView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmAct:ActivoTrasladoViewModel}">
        <viewsAct:ActivoTrasladoView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vmAct:ActivoBajaViewModel}">
        <viewsAct:ActivoBajaView/>
    </DataTemplate>

</ResourceDictionary>
